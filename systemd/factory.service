# project-factory systemd unit.
#
# factory/main.py is a persistent state-machine loop (plan.md section 6), not a
# one-shot script, so this runs it as a long-lived service rather than a timer.
# `run` is the chosen subcommand for "start the daemon loop", alongside the
# separate `status`/`pause`/`resume`/`report` CLI helpers (plan.md section 10).
#
# Install with systemd/install.sh, which resolves factory.env (PATH, incl. the
# nvm-installed `claude` CLI) and copies this file into /etc/systemd/system/.

[Unit]
Description=project-factory autonomous runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=factory
Group=factory
WorkingDirectory=/home/factory/project-factory

# factory.env is generated by install.sh at install time and holds PATH
# (venv + the resolved nvm `claude` bin dir) plus any other required env vars.
EnvironmentFile=/home/factory/project-factory/systemd/factory.env

ExecStart=/home/factory/project-factory/.venv/bin/python -m factory.main run

# Rate limits (5-hour / weekly subscription caps, plan.md section 9) are
# handled inside the app: on a rate-limit error it writes state/paused_until
# and sleeps, then resumes on its own. Restart=on-failure with a 60s delay is
# only for crashes, not for fighting that in-process backoff with a tight
# systemd restart loop.
Restart=on-failure
RestartSec=60

# Hardening. Not PrivateNetwork=true: the runner needs outbound HTTPS for the
# GitHub and Claude Code API calls.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/home/factory/project-factory/state /home/factory/factory-workspace

[Install]
WantedBy=multi-user.target
